{
  "_version": "1.65.0",
  "sap.app": {
    "id": "ziloadminmodels",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "AdminService": {
        "uri": "api/admin/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "zilo_models_inbound": {
          "semanticObject": "ZiloModels",
          "action": "manage",
          "title": "{{appTitle}}",
          "icon": "sap-icon://list",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": true,
    "supportedThemes": [
      "sap_horizon"
    ],
    "icons": {
      "icon": "sap-icon://list"
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": false
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.130.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "AdminService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "ziloadminmodels.i18n.i18n",
          "supportedLocales": [
            "en",
            "pt",
            "pt_BR"
          ],
          "fallbackLocale": "en"
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "list",
          "target": "list"
        },
        {
          "pattern": "/ModelCatalog({key}):?query:",
          "name": "detail",
          "target": "detail"
        }
      ],
      "targets": {
        "list": {
          "type": "Component",
          "id": "list",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "ModelCatalog",
              "variantManagement": "None",
              "initialLoad": true
            }
          }
        },
        "detail": {
          "type": "Component",
          "id": "detail",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "ModelCatalog"
            }
          }
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "analytical"
  },
  "sap.cloud": {
    "public": true,
    "service": "ziloadmin"
  }
}
